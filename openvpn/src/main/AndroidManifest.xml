<!--    android:name=".core.ICSOpenVPNApplication"-->
    <application
        android:extractNativeLibs="true"
        tools:ignore="UnusedAttribute">
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />

        <activity
            android:name=".activities.DisconnectVPN"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".DisconnectVPN"
            android:theme="@style/blinkt.dialog" />


        <!--
          The de.blinkt.openvpn.core.OpenVPNService declaration that used to sit here is gone.
          It was already dead - the class is ABSTRACT, so the system could never instantiate it -
          yet it claimed the android.net.VpnService action and asked for a :openvpn process, which
          made Always-on VPN targeting depend on manifest merge order (§1.2). OpenVPN is now an
          engine, not a service at all; the only VpnService in the app is WindscribeVpnService.

          Everything below is dead code kept for now: all exported="false", none reachable from
          :base / :mobile / :tv, and the ones that bind OpenVPNService as a Service can no longer
          work. Removal is WS0 cleanup.
        -->
        <service
            android:name=".api.ExternalOpenVPNService"
            android:process=":openvpn"
            android:exported="false">
            <intent-filter>
                <action android:name="de.blinkt.openvpn.api.IOpenVPNAPIService" />
            </intent-filter>
        </service>
        <service
            android:name=".core.OpenVPNStatusService"
            android:exported="false"
            android:process=":openvpn" />

        <activity android:name=".api.GrantPermissionsActivity"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".api.ConfirmDialog"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <receiver android:name=".OnBootReceiver"
                android:exported="false"
                android:enabled="false">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>


        <activity
            android:name=".LaunchVPN"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:label="@string/vpn_launch_title"
            android:taskAffinity=".LaunchVPN"
            android:theme="@style/blinkt.dialog"
            android:exported="false">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!--
        <receiver android:name="core.GetRestrictionReceiver">
            <intent-filter>
                <action android:name="android.intent.action.GET_RESTRICTION_ENTRIES" />
            </intent-filter>
        </receiver>
        -->
        <activity android:name=".api.RemoteAction" />

        <activity-alias
            android:name=".api.ConnectVPN"
            android:exported="false"
            android:targetActivity=".api.RemoteAction" />
        <activity-alias
            android:name=".api.DisconnectVPN"
            android:exported="false"
            android:targetActivity=".api.RemoteAction" />
    </application>

</manifest>