<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <!--
          The .logic.CharonVpnService declaration that used to sit here is gone. That class is no
          longer a Service at all - it is the IKEv2 engine, a plain object behind PacketMux - and it
          used to claim the android.net.VpnService action, which made Always-on VPN targeting depend
          on manifest merge order. The only VpnService in the app is now WindscribeVpnService in
          :base. See docs/architecture/VPN_BACKEND.md §2.

          Note the CLASS NAME org.strongswan.android.logic.CharonVpnService is still load-bearing:
          libandroidbridge.so resolves it by name (constraint C1, §5.3). Only the manifest
          declaration is removed, never the class.
        -->
        <service
            android:name="org.strongswan.android.logic.VpnStateService"
            android:exported="false" />
    </application>
</manifest>
