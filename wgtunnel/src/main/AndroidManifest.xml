<!--
  GoBackend$VpnService is gone. wg-go is an engine now, not a service, and the only
  android.net.VpnService in the app is WindscribeVpnService in :base. Collapsing these
  declarations is the point: four separate services used to claim the android.net.VpnService
  action, so which one the system handed Always-on VPN was manifest-merge-order dependent.
  See docs/architecture/VPN_BACKEND.md §2.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

</manifest>
